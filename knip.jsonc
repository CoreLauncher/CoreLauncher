{
	"$schema": "./node_modules/knip/schema-jsonc.json",
	"rules": {
		"duplicates": "off",
		"exports": "off"
	},
	"ignoreBinaries": ["i", "build", "CoreLauncher"],
	"ignoreDependencies": [
		"@types/react",
		"@types/react-dom",
		"@fontsource/inter",
		"@fontsource-variable/rubik",
		"@biomejs/biome",
		"protoc",
		"ts-proto"
	],
	"workspaces": {
		"packages/*": {
			"entry": ["**/*.d.ts", "**/*.test.ts"]
		},
		"packages/steam-client": {
			"entry": ["protobuf/generated/**/*.ts"]
		},
		"plugins/*": {
			"entry": ["public/index.tsx", "migrations/*.ts"]
		},
		"packages/react": {
			"ignoreDependencies": ["react", "react-dom"]
		},
		"packages/typed-emitter": {
			"ignoreDependencies": ["events"]
		}
	}
}
